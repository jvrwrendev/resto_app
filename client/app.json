{
  "expo": {
    "name": "MINI POS",
    "slug": "bbq-pos",
    "icon": "./assets/bbq.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#B45309"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bbqpos.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Used to connect to your thermal receipt printer.",
        "NSBluetoothPeripheralUsageDescription": "Used to connect to your thermal receipt printer.",
        "NSPhotoLibraryUsageDescription": "Used to attach a photo to your products.",
        "NSCameraUsageDescription": "Used to take product photos."
      }
    },
    "android": {
      "package": "com.bbqpos.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "./plugins/withBluetoothPrinter"
    ],
    "extra": {
      "eas": {
        "projectId": "4523bcd6-88c3-460b-b471-38ce4bb3066d"
      }
    }
  }
}
